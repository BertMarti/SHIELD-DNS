# SHIELD-DNS - variables de configuración
# install.sh crea .env a partir de este archivo y genera la contraseña automáticamente.

# Zona horaria
TZ=Europe/Madrid

# Contraseña del panel web de Pi-hole (install.sh la genera si está vacía)
PIHOLE_PASSWORD=

# Puertos del panel web en el host (DNS siempre usa el 53)
WEB_HTTP_PORT=8080
WEB_HTTPS_PORT=8443

# Listas de bloqueo extra que install.sh añade además de la lista por defecto de Pi-hole.
# Separadas por espacios. Déjalo vacío para usar solo la lista por defecto.
EXTRA_ADLISTS="https://cdn.jsdelivr.net/gh/hagezi/dns-blocklists@latest/adblock/multi.txt"
